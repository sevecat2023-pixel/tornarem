# =============================================================
# TornaBox — .htaccess (Hostinger / Apache / LiteSpeed)
# Caché correcta, tipos MIME, página 404 y protección de pedidos.
# =============================================================

# --- 404 con marca ---
ErrorDocument 404 /404.html

# --- Nadie puede leer el registro de pedidos por la web ---
<Files "pedidos.log">
  Require all denied
</Files>

# --- La base de datos de pedidos (nombres, direcciones, teléfonos) y el
#     código del servidor NO se sirven jamás por web ---
RedirectMatch 404 /datos(/|$)
<FilesMatch "^(server\.js)$">
  Require all denied
</FilesMatch>

# --- EL CRM, BLOQUEADO POR DEFECTO ---
# En un hosting compartido tipo Hostinger no hay Node, así que la API de
# pedidos no puede correr y el panel no serviría de nada; y dejarlo abierto
# expondría datos personales. Se deniega.
# Para usarlo aquí de verdad: crea un .htpasswd fuera de public_html,
# borra estas cuatro líneas y descomenta el bloque de abajo.
<FilesMatch "^(admin\.html|admin\.js)$">
  Require all denied
</FilesMatch>
# <FilesMatch "^(admin\.html|admin\.js)$">
#   AuthType Basic
#   AuthName "CRM de pedidos"
#   AuthUserFile /home/TU-USUARIO/.htpasswd
#   Require valid-user
# </FilesMatch>

# --- Si la web se publica clonando el repositorio (Git de Hostinger),
#     estos archivos viajan con él pero no deben servirse ---
<FilesMatch "^(README\.md|DESPLIEGUE\.md|deploy-vps\.sh|\.gitignore|\.nojekyll)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 /\.git(/|$)
RedirectMatch 404 /\.github(/|$)

# --- Caché: HTML/CSS/JS se revalidan; imágenes y fuentes, 1 mes ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 hours"
  ExpiresByType application/javascript "access plus 1 hours"
  ExpiresByType application/json "access plus 1 hours"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|js|mjs|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|woff|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType application/javascript .js
  AddType text/css .css
  AddType font/woff2 .woff2
</IfModule>

